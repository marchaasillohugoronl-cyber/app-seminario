<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_aviso" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
        <TextView android:id="@+id/aviso_encabezado" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/aviso_aplicativo" android:textColor="#C5E5FF" android:textSize="14sp" android:gravity="center" />
        <ImageView android:id="@+id/aviso_icono" android:layout_width="120dp" android:layout_height="120dp"
            android:layout_marginTop="24dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/aviso_titulo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textSize="23sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:accessibilityHeading="true" />
        <TextView android:id="@+id/aviso_mensaje" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="16sp" android:lineSpacingExtra="4dp" android:textColor="#E0EEFA" android:gravity="center" />
        <com.google.android.material.button.MaterialButton android:id="@+id/aviso_aceptar"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
            android:layout_marginTop="24dp" android:textColor="#153551" android:textAllCaps="false" android:textSize="16sp"
            app:backgroundTint="#FFBD44" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/aviso_secundario"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
            android:layout_marginTop="8dp" android:text="@string/opciones_eliminar"
            android:textColor="#FFD6AD" android:textAllCaps="false" android:textSize="16sp"
            android:visibility="gone" app:strokeColor="#81ACCB" app:cornerRadius="14dp"
            app:icon="@drawable/ic_opcion_eliminar" app:iconTint="#FFD6AD" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/aviso_cancelar"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/aviso_cancelar" android:textColor="#FFFFFF" android:textAllCaps="false" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
